{
  "name": "skill-image",
  "version": "0.2.1",
  "description": "Claude Code skill + CLI: AI 图像生成器。7 种模式（--app/--arch/--explode/--product/--scene/--detail/--slide），零依赖纯 ESM，自动读 API Key，白底 PNG 可直接拖入 PPT。",
  "type": "commonjs",
  "main": "./lib/skill-image.mjs",
  "exports": {
    ".": {
      "import": "./lib/skill-image.mjs",
      "default": "./lib/skill-image.mjs"
    }
  },
  "bin": {
    "skill-image": "./bin/skill-image.js"
  },
  "scripts": {
    "smoke": "node scripts/smoke.js"
  },
  "files": [
    ".claude-plugin/",
    "lib/",
    "bin/",
    "skills/",
    "scripts/",
    "README.md",
    "LICENSE",
    "skill-package-manifest.json"
  ],
  "keywords": [
    "claude-code",
    "claude-skill",
    "fmode",
    "image",
    "ai",
    "architecture",
    "diagram",
    "scene",
    "product",
    "design",
    "explode",
    "presentation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmodecn/skill-image.git"
  },
  "bugs": {
